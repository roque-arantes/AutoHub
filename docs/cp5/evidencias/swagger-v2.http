            "name": "page",
            "in": "query",
            "description": "Número da página (padrão: 1, mínimo: 1).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Itens por página (padrão: 20, de 1 a 100).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
