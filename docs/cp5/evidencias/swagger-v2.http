  "paths": {
    "/api/Clientes": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Lista todos os clientes cadastrados.",
        "responses": {
          "200": {
            "description": "Clientes retornados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClienteResponseDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Cadastra um novo cliente no sistema.",
        "requestBody": {
          "description": "Dados do cliente para criação.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClienteResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos no corpo da requisição.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflito: Já existe um cliente com o CPF informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Clientes/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Obtém os dados de um cliente pelo seu identificador único (ID).",
